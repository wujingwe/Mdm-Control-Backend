# =============================================================================
# MDM Control Backend — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values for your environment.
# All variables have sensible defaults for local development.
# =============================================================================

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------

# SQLAlchemy async connection string (MariaDB via aiomysql)
DB_URL=mysql+aiomysql://user:pass@localhost:3306/mdm_control

# Dedicated MariaDB used by `make test-integration` (tests truncate all tables).
# Credentials must match DB_URL's. Leave unset/quoted-empty to skip the suite.
INTEGRATION_DB_URL=mysql+aiomysql://user:pass@localhost:3306/mdm_control_test

# Use SQLite in-memory database instead of MariaDB (for testing/development)
MOCK_DB=false

# -----------------------------------------------------------------------------
# RabbitMQ
# -----------------------------------------------------------------------------

# AMQP connection URL
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# -----------------------------------------------------------------------------
# Webhooks & Notifications
# -----------------------------------------------------------------------------

# Backend webhook URL for cache revalidation (called after mutations)
WEBHOOK_URL=http://localhost:3000/api/v1/revalidate

# Shared secret sent with revalidation webhook requests
REVALIDATION_SECRET=

# Shared secret that guards internal endpoints (e.g. POST /api/v1/assignments/sweep).
# Provision once as a k8s Secret and mount it into both the app Deployment and
# the assignment-sweep CronJob.
SWEEP_SECRET=



# -----------------------------------------------------------------------------
# SSO / JWT Authentication
# -----------------------------------------------------------------------------

# JSON Web Key Set URL for JWT signature verification
SSO_JWKS_URL=

# Expected JWT issuer claim
SSO_ISSUER=

# Expected JWT audience claim
SSO_AUDIENCE=

# -----------------------------------------------------------------------------
# Local dev auth (fake IdP — mimics AAD OIDC flow without Docker/Keycloak)
# -----------------------------------------------------------------------------

# Expose POST /api/v1/auth/dev-token to mint JWTs for local development
DEV_AUTH_ENABLED=false

# PEM-encoded RSA private key for dev-token signing.
DEV_AUTH_PRIVATE_KEY=

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------

# Comma-separated list of allowed origins
# Example: CORS_ORIGINS=["http://localhost:3000","https://admin.example.com"]
CORS_ORIGINS=["*"]
