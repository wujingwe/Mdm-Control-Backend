# =============================================================================
# MDM Control Backend — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values for your environment.
# All variables have sensible defaults for local development.
# =============================================================================

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------

# SQLAlchemy async connection string (MariaDB via aiomysql)
DB_URL=mysql+aiomysql://jing-weiwu:mdm@localhost:3306/mdm_control

# Use SQLite in-memory database instead of MariaDB (for testing/development)
MOCK_DB=false

# -----------------------------------------------------------------------------
# RabbitMQ
# -----------------------------------------------------------------------------

# AMQP connection URL
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# -----------------------------------------------------------------------------
# Webhooks & Notifications
# -----------------------------------------------------------------------------

# Backend webhook URL for cache revalidation (called after mutations)
WEBHOOK_URL=http://localhost:3000/api/v1/revalidate

# Shared secret sent with revalidation webhook requests
REVALIDATION_SECRET=



# -----------------------------------------------------------------------------
# SSO / JWT Authentication
# -----------------------------------------------------------------------------

# Enable SSO-based JWT authentication on API routes
SSO_ENABLED=false

# JSON Web Key Set URL for JWT signature verification
SSO_JWKS_URL=

# Expected JWT issuer claim
SSO_ISSUER=

# Expected JWT audience claim
SSO_AUDIENCE=

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------

# Comma-separated list of allowed origins
# Example: CORS_ORIGINS=["http://localhost:3000","https://admin.example.com"]
CORS_ORIGINS=["*"]
